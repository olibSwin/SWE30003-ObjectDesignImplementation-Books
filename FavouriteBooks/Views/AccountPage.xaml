<Page x:Class="FavouriteBooks.Views.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Account">

    <Grid Margin="20">

        <!-- LOGIN PANEL -->
        <StackPanel x:Name="LoginPanel"
                    Visibility="Visible"
                    Width="350"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Login"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock Text="Email"/>
            <TextBox x:Name="LoginEmail"
                     Margin="0 5 0 10"
                     Padding="5"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="LoginPassword"
                         Margin="0 5 0 20"
                         Padding="5"/>

            <Button Content="Login"
                    Click="Login_Click"
                    Padding="10 5"
                    Margin="0 0 0 10"/>

            <Button Content="Don't have an account? Register"
                    Click="ShowRegister_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#2C3E50"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- REGISTER PANEL -->
        <StackPanel x:Name="RegisterPanel"
                    Visibility="Collapsed"
                    Width="350"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Register"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock Text="Name"/>
            <TextBox x:Name="RegisterName"
                     Margin="0 5 0 10"
                     Padding="5"/>

            <TextBlock Text="Email"/>
            <TextBox x:Name="RegisterEmail"
                     Margin="0 5 0 10"
                     Padding="5"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="RegisterPassword"
                         Margin="0 5 0 10"
                         Padding="5"/>

            <TextBlock Text="Phone Number"/>
            <TextBox x:Name="RegisterPhone"
                     Margin="0 5 0 10"
                     Padding="5"/>

            <TextBlock Text="Delivery Address"/>
            <TextBox x:Name="RegisterAddress"
                     Margin="0 5 0 20"
                     Padding="5"/>

            <Button Content="Register"
                    Click="Register_Click"
                    Padding="10 5"
                    Margin="0 0 0 10"/>

            <Button Content="Already have an account? Login"
                    Click="ShowLogin_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#2C3E50"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- ACCOUNT MANAGEMENT (FIXED SCROLL VERSION) -->
        <ScrollViewer x:Name="AccountScroll"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Width="350"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">

                <TextBlock Text="My Account"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 0 0 20"/>

                <TextBlock x:Name="WelcomeText"
                           FontSize="14"
                           Margin="0 0 0 20"/>

                <TextBlock Text="Name"/>
                <TextBox x:Name="ManageName"
                         Margin="0 5 0 10"
                         Padding="5"/>

                <TextBlock Text="Phone Number"/>
                <TextBox x:Name="ManagePhone"
                         Margin="0 5 0 10"
                         Padding="5"/>

                <TextBlock Text="Delivery Address"/>
                <TextBox x:Name="ManageAddress"
                         Margin="0 5 0 20"
                         Padding="5"/>

                <Button Content="Save Changes"
                        Click="SaveChanges_Click"
                        Padding="10 5"
                        Margin="0 0 0 10"/>

                <Button Content="Logout"
                        Click="Logout_Click"
                        Padding="10 5"
                        Background="#E74C3C"
                        Foreground="White"
                        BorderThickness="0"/>

                <TextBlock Text="Order History"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0 20 0 10"/>

                <ListView x:Name="OrderHistoryList"
                          MaxHeight="250">

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Order ID"
                                            Width="90"
                             DisplayMemberBinding="{Binding Id}" />

                            <GridViewColumn Header="Date"
                                            Width="100"
                             DisplayMemberBinding="{Binding Date}" />

                            <GridViewColumn Header="Status"
                             DisplayMemberBinding="{Binding Status}" />

                            <GridViewColumn Header="Items"
                                            Width="35"
                             DisplayMemberBinding="{Binding ItemsCount}" />

                            <GridViewColumn Header="Total"
                              DisplayMemberBinding="{Binding Total, StringFormat={}{0:C}}" />
                        </GridView>
                    </ListView.View>

                </ListView>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>