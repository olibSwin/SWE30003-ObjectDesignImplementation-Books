<Page x:Class="FavouriteBooks.Views.HomePage"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   Title="HomePage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="Welcome to Favourite Books Glenferrie"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1"
                   Text="The online bookstore for Favourite Books on Glenferrie road. Order online to get books delivered to your doorstep. (must be close to Hawthorn) "
                   FontSize="14"
                   Foreground="Gray"
                   Margin="0,0,0,20"/>

            <!-- Info Cards -->
            <StackPanel Grid.Row="2" Orientation="Vertical">

                <Border Padding="10" Margin="0,0,0,10" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📚 Browse Books" FontWeight="Bold"/>
                        <TextBlock Text="Explore a curated catalogue of classic and modern books."/>
                    </StackPanel>
                </Border>

                <Border Padding="10" Margin="0,0,0,10" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="👤 Account System" FontWeight="Bold"/>
                        <TextBlock Text="Register, log in, and manage your personal details."/>
                    </StackPanel>
                </Border>

                <Border Padding="10" Margin="0,0,0,10" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Create an Account!" FontWeight="Bold"/>
                        <TextBlock Text="Create an account to get started."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="3"
                   VerticalAlignment="Bottom"
                   Foreground="Gray"
                   FontSize="12"
                   Text="SWE30003 Assignment 3 | Swinburne University"/>

        </Grid>
    </ScrollViewer>

</Page>
