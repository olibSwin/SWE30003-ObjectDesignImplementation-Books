<Page x:Class="FavouriteBooks.Views.OrderCompletePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FavouriteBooks.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderCompletePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Order Completed" FontSize="30" FontFamily="Arial Black" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Row="1" Margin="20,70,0,0">
            <TextBlock Grid.Row="1" Text="Order Review" FontSize="20" TextDecorations="Underline" FontWeight="SemiBold" />
            <TextBlock Text="Items:" TextDecorations="Underline" Margin="10,5,0,5" />
            <ListView Margin="10,0,0,5"  Name="OrderItemList" d:ItemsSource="{d:SampleData ItemCount=5}" IsTextSearchEnabled="False" IsHitTestVisible="False" Focusable="False">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="Title" Width="120" DisplayMemberBinding="{Binding Book.Title}" />
                        <GridViewColumn Header="Author" Width="120" DisplayMemberBinding="{Binding Book.Author}" />
                        <GridViewColumn Header="Quantity" Width="75" DisplayMemberBinding="{Binding Quantity}" />
                        <GridViewColumn Header="Price" Width="70" DisplayMemberBinding="{Binding BookPurchasePrice}" />
                        <GridViewColumn Header="Subtotal" Width="70" DisplayMemberBinding="{Binding SubTotal}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,5">
                <TextBlock Text="Order Date:" TextDecorations="Underline" />
                <TextBlock x:Name="OrderDate" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,5">
                <TextBlock Text="Order Status:" TextDecorations="Underline" />
                <TextBlock x:Name="OrderStatusInfo" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                <TextBlock Text="Shipping Cost:" TextDecorations="Underline" />
                <TextBlock x:Name="ShippingCost" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="50,70,30,0">
            <TextBlock Grid.Row="1" Text="Receipt" FontSize="20" TextDecorations="Underline" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="10,5,0,5">
                <TextBlock Text="Receipt ID:" TextDecorations="Underline" />
                <TextBlock x:Name="ReceiptId" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,5">
                <TextBlock Text="Date Issued:" TextDecorations="Underline" />
                <TextBlock x:Name="ReceiptDate" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,5">
                <TextBlock Text="Amount Paid:" TextDecorations="Underline" />
                <TextBlock x:Name="ReceiptPaid" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,70,0,0" Content="Return to home" Click="Home_Click" Width="150" Height="35" />
    </Grid>
</Page>
